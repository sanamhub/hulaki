<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Hulaki.Mastodon</RootNamespace>
    <!-- Binds MastodonChannelOptions with generated code instead of reflection, so AOT apps can bind it. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Hulaki.Mastodon</PackageId>
    <Description>Hulaki provider for Mastodon: posts a status with an Idempotency-Key, so a retried post is never published twice, and counts length the way Mastodon does, with URLs as 23 characters.</Description>
    <PackageTags>notifications;mastodon;fediverse;activitypub;social;hulaki</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hulaki/Hulaki.csproj" />
    <ProjectReference Include="../Hulaki.Extensions.DependencyInjection/Hulaki.Extensions.DependencyInjection.csproj" />
    <InternalsVisibleTo Include="Hulaki.Mastodon.Tests" />
    <!-- The CLI builds channels from channel URLs with the internal parser (ADR-0013). -->
    <InternalsVisibleTo Include="Hulaki.Cli" />
    <!-- Settings binding and DI registration shared by every provider, without a public type. -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
