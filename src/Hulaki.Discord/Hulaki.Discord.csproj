<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Hulaki.Discord</RootNamespace>
    <!-- Binds DiscordChannelOptions with generated code instead of reflection, so AOT apps can bind it. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Hulaki.Discord</PackageId>
    <Description>Hulaki provider for Discord: posts to a channel through an incoming webhook, with markup rendered as escaped Discord Markdown and mentions switched off.</Description>
    <PackageTags>notifications;discord;webhook;hulaki</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hulaki/Hulaki.csproj" />
    <ProjectReference Include="../Hulaki.Extensions.DependencyInjection/Hulaki.Extensions.DependencyInjection.csproj" />
    <InternalsVisibleTo Include="Hulaki.Discord.Tests" />
    <!-- Settings binding and DI registration shared by every provider, without a public type. -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
