<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Hulaki</RootNamespace>
    <!-- Binds each channel's options with generated code instead of reflection, so AOT apps can bind them. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Hulaki</PackageId>
    <Description>Delivers a message to people and accounts on chat, push and social platforms with one API, and reports per recipient whether it was delivered, rejected or lost in flight. Includes the Telegram, Discord, Slack, Teams, ntfy, Web Push, webhook, Bluesky and Mastodon channels and AddHulaki() for dependency injection. Email over SMTP is in Hulaki.Email.</Description>
    <PackageTags>notifications;telegram;discord;slack;teams;ntfy;webpush;webhook;bluesky;mastodon;social</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <InternalsVisibleTo Include="Hulaki.Tests" />
    <!-- The CLI builds channels from channel URLs with the internal parsers (ADR-0013). -->
    <InternalsVisibleTo Include="Hulaki.Cli" />
    <!-- Settings binding and DI registration shared with Hulaki.Email, without a public type. -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
