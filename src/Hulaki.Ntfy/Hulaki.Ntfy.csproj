<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Hulaki.Ntfy</RootNamespace>
    <!-- Binds NtfyChannelOptions with generated code instead of reflection, so AOT apps can bind it. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Hulaki.Ntfy</PackageId>
    <Description>Hulaki provider for ntfy: publishes to a topic on ntfy.sh or a self-hosted server, with title, priority, click link and Markdown.</Description>
    <PackageTags>notifications;ntfy;push;hulaki</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hulaki/Hulaki.csproj" />
    <ProjectReference Include="../Hulaki.Extensions.DependencyInjection/Hulaki.Extensions.DependencyInjection.csproj" />
    <InternalsVisibleTo Include="Hulaki.Ntfy.Tests" />
    <!-- The CLI builds channels from channel URLs with the internal parser (ADR-0013). -->
    <InternalsVisibleTo Include="Hulaki.Cli" />
    <!-- Settings binding and DI registration shared by every provider, without a public type. -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
