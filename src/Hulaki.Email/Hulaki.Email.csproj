<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Hulaki.Email</RootNamespace>
    <!-- Binds EmailChannelOptions with generated code instead of reflection, so AOT apps can bind it. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Hulaki.Email</PackageId>
    <Description>Hulaki provider for email through FreeTierMail: one SMTP server by default, or switch on UseFreeTierMail to send through Resend, Brevo and other accounts with quota-aware failover. A plain text and an HTML part, outcomes mapped to Hulaki's retry rules.</Description>
    <PackageTags>notifications;email;smtp;resend;brevo;freetiermail;hulaki</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hulaki/Hulaki.csproj" />
    <!-- FreeTierMail.Smtp brings FreeTierMail and MailKit. -->
    <PackageReference Include="FreeTierMail.Smtp" />
    <InternalsVisibleTo Include="Hulaki.Email.Tests" />
    <!-- The CLI builds channels from channel URLs with the internal parser (ADR-0013). -->
    <InternalsVisibleTo Include="Hulaki.Cli" />
    <!-- Settings binding and DI registration shared by every provider, without a public type. -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
