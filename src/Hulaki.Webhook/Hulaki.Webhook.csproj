<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Hulaki.Webhook</RootNamespace>
    <!-- Binds WebhookChannelOptions with generated code instead of reflection, so AOT apps can bind it. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Hulaki.Webhook</PackageId>
    <Description>Hulaki provider for any HTTP endpoint: posts a small JSON document, or a body from your template, with an optional HMAC-SHA256 signature the receiver can verify.</Description>
    <PackageTags>notifications;webhook;hmac;hulaki</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hulaki/Hulaki.csproj" />
    <ProjectReference Include="../Hulaki.Extensions.DependencyInjection/Hulaki.Extensions.DependencyInjection.csproj" />
    <InternalsVisibleTo Include="Hulaki.Webhook.Tests" />
    <!-- The CLI builds channels from channel URLs with the internal parser (ADR-0013). -->
    <InternalsVisibleTo Include="Hulaki.Cli" />
    <!-- Settings binding and DI registration shared by every provider, without a public type. -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
