<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Hulaki.Extensions.DependencyInjection</RootNamespace>
    <!-- Binds options with generated code instead of reflection, so AOT apps can bind them. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Hulaki.Extensions.DependencyInjection</PackageId>
    <Description>Registers Hulaki with Microsoft.Extensions.DependencyInjection: AddHulaki() adds the client and an idempotency store, and provider packages add named channels with options bound from configuration and validated at startup.</Description>
    <PackageTags>notifications;dependency-injection;configuration;hulaki</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hulaki/Hulaki.csproj" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
