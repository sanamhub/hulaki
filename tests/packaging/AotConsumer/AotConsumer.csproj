<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumes the packed Hulaki and Hulaki.Telegram under Native AOT. Not in Hulaki.slnx: it can
       only restore after `dotnet pack -c Release -o artifacts/packages`. CI publishes it with
       -r linux-x64 and runs the binary, which prints Delivered. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A trim or AOT warning (IL2xxx, IL3xxx) from our packages fails the publish. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Roots every type in Hulaki, so the trimmer analyses the whole core, not just what one send
         reaches. -->
    <TrimmerRootAssembly Include="Hulaki" />
    <PackageReference Include="Hulaki" Version="$(HulakiVersion)" />
    <PackageReference Include="Hulaki.Telegram" Version="$(HulakiVersion)" />
  </ItemGroup>
  <!-- The version to consume is passed in (-p:HulakiVersion=...), so a stale package can never be
       picked up by accident. -->
  <Target Name="RequireHulakiVersion" BeforeTargets="_CheckForInvalidConfigurationAndPlatform;CollectPackageReferences">
    <Error Condition="'$(HulakiVersion)' == ''" Text="Pass -p:HulakiVersion=&lt;the version in Directory.Build.props&gt;." />
  </Target>
</Project>
