<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    clear drops any source inherited from a machine or user level NuGet.Config. Without it, a
    source configured elsewhere on the build machine silently becomes a source for this
    repository too, and restore results stop being reproducible.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      FreeTierMail, which Hulaki.Email sends through, is not on nuget.org yet. Its packages are
      committed here, packed from the FreeTierMail repository's HEAD with a -dev version. Remove
      this source once FreeTierMail is published.
    -->
    <add key="local" value="packages-local" />
  </packageSources>

  <!--
    Package source mapping. With a single source this looks redundant, and it is not: it means
    the day a second source is added, every existing package keeps resolving from nuget.org
    instead of being open to whichever source answers first. That is the dependency confusion
    attack, and this is the control for it.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- The more specific pattern wins, so these never resolve from nuget.org. -->
    <packageSource key="local">
      <package pattern="FreeTierMail" />
      <package pattern="FreeTierMail.*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    Audit every restore against the GitHub Advisory Database. Directory.Build.props turns high and
    critical advisories into errors and leaves low and moderate as warnings. This runs locally as
    well as in CI, so a vulnerable transitive dependency surfaces at the desk rather than at the
    merge gate.
  -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>

</configuration>
