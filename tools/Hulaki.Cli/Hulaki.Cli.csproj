<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hulaki.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hulaki</ToolCommandName>
    <PackageId>Hulaki.Cli</PackageId>
    <Description>The hulaki command: prints every provider's capability manifest, sends a test message through a channel URL, and checks a channel URL without sending. Secrets in channel URLs are never printed.</Description>
    <PackageTags>notifications;cli;dotnet-tool;hulaki</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="../../src/Hulaki/Hulaki.csproj" />
    <ProjectReference Include="../../src/Hulaki.Email/Hulaki.Email.csproj" />
    <InternalsVisibleTo Include="Hulaki.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
